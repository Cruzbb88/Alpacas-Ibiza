# ======================================================================
# Alpacas Ibiza — .env.local template
# ======================================================================
# Copy to .env.local and fill in real values.
# NEVER commit .env.local (already gitignored).
# ======================================================================

# ---------- Email (required) -----------------------------------------
# Resend — primary transactional email provider.
# Get key: https://resend.com/api-keys
RESEND_API_KEY=re_xxx_your_key_here
CONTACT_EMAIL=info@alpacasibiza.com

# ---------- FareHarbor booking (required) ----------------------------
# Public vars — visible in browser
NEXT_PUBLIC_FAREHARBOR_SHORTNAME=alpacasibiza
NEXT_PUBLIC_FAREHARBOR_FLOW_ID=1257173

# Per-tour FareHarbor item IDs (canonical names — match lib/validate-env.ts Tier 2)
# Find in FareHarbor: Online Booking -> Booking Flows -> Default Flow -> click each tour, copy numeric ID
FAREHARBOR_ITEM_TOUR_MEET_HERD=
FAREHARBOR_ITEM_TOUR_WEAVING_WORKSHOP=
FAREHARBOR_ITEM_TOUR_FARM_EXPERIENCE=
FAREHARBOR_ITEM_TOUR_PHOTO_SESSION=

# Activity item IDs (yoga, weddings, experiences, gifts)
FAREHARBOR_ITEM_YOGA=
FAREHARBOR_ITEM_WEDDINGS=
FAREHARBOR_ITEM_PHOTOSHOOTS=
FAREHARBOR_ITEM_ROMANTIC_SUNSET=
FAREHARBOR_ITEM_FAMILY_FARM_DAYS=
FAREHARBOR_ITEM_BUSINESS_INCENTIVES=
FAREHARBOR_ITEM_GIFT_CARD=

# Shop category item IDs (FareHarbor-routed catalog per ADR 004)
FAREHARBOR_ITEM_WOVEN=
FAREHARBOR_ITEM_COMMISSION=
FAREHARBOR_ITEM_ALCACA=

# ---------- FareHarbor API (optional, Pro plan) ----------------------
# Enables /api/availability showing live "X spots left" urgency
# Contact support@fareharbor.com to request External API access
FAREHARBOR_APP_KEY=
FAREHARBOR_USER_KEY=
FAREHARBOR_SHORTNAME=alpacasibiza
FAREHARBOR_ITEM_ID=

# ---------- FareHarbor webhooks (optional) ---------------------------
# Set in FareHarbor dashboard under Integrations -> Webhooks.
# Protects /api/review-request, /api/reminder endpoints from unauthorized calls.
FAREHARBOR_WEBHOOK_SECRET=

# ---------- Admin analytics dashboard (NextAuth) ---------------------
# REQUIRED for production — defaults are "admin"/"password" (SECURITY RISK)
ADMIN_USERNAME=
ADMIN_PASSWORD=
NEXTAUTH_SECRET=change_me_to_a_random_32_plus_char_string
NEXTAUTH_URL=https://alpacasibiza.com

# ---------- Google Analytics (optional) ------------------------------
# Client-side tag — already loaded in layout.tsx
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Y946QDVVQV

# Server-side Data API — powers /admin/analytics dashboard.
# Alternative: invite the owner to GA4 directly (Admin -> Account Access).
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# ---------- CAPTCHA / bot protection ---------------------------------
# Select the active captcha provider. Routes auto-switch — no code edits.
#   recaptcha  →  Google reCAPTCHA v3  ← RECOMMENDED: the live alpacasibiza.com
#                 already runs reCAPTCHA, so you can reuse the SAME keys here
#                 and skip a new Cloudflare signup (verified 2026-06-10).
#   turnstile  →  Cloudflare Turnstile (free, no scoring; the code default)
#   none       →  disabled (dev/preview only — leaves forms unprotected)
CAPTCHA_PROVIDER=recaptcha

# Google reCAPTCHA v3 (active provider above) — paste the keys the live site
# already uses, or register: https://www.google.com/recaptcha/admin/create (v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score threshold: requests below this score are rejected (0.0–1.0).
# Google default 0.5; raise to 0.7 for stricter protection.
RECAPTCHA_MIN_SCORE=0.5

# Cloudflare Turnstile (alternative — used only if CAPTCHA_PROVIDER=turnstile)
# Register a site: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- SendGrid (optional newsletter list management) -----------
# Used only if newsletter subscribers should sync to a SendGrid contact list.
# Resend handles the owner notification email either way.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@alpacasibiza.com
SENDGRID_LIST_ID=

# ---------- Newsletter double opt-in (optional — Tier 2) -------------
# HMAC key for signing newsletter confirmation tokens.
# Falls back to NEXTAUTH_SECRET if unset (Tier 1 guarantee).
# Set a dedicated value to allow independent rotation without re-signing all tokens.
# Generate: openssl rand -hex 32
NEWSLETTER_SIGNING_KEY=

# ---------- Cron security (for scheduled digest endpoints) -----------
# Used by /api/owner-digest, /api/owner-mrr-digest, /api/alpaca-birthday-cards,
# and all adopt crons. Generate: openssl rand -hex 32
CRON_SECRET=

# Preview-only manual birthday trigger (admin/birthday-test page).
# !! SECURITY WARNING: MUST NEVER be set on the production public deployment !!
# Setting it on production inlines the cron secret into every visitor's browser bundle.
# Safe usage: set ONLY on Vercel Preview deployments with restricted access.
# (trigger-form.tsx enforces the guard in code too, but don't set it at all on prod.)
# NEXT_PUBLIC_CRON_SECRET_PREVIEW=

# ---------- Site origin (override per environment) -------------------
# Used for metadata, sitemap, hreflang, OG URLs, Stripe/Mollie success/cancel.
# Production: leave blank (code defaults to https://alpacasibiza.com via lib/config.ts)
# Preview: Vercel does NOT auto-set this — set manually to your preview URL if needed.
# IMPORTANT: if you ever change the production domain, set SITE_BASE_URL here too.
NEXT_PUBLIC_SITE_URL=

# ---------- Payment provider selection (Tier 2) ----------------------
# Default: 'mollie' per ADR 019 (lower fees: ~€0.25/charge SEPA vs Stripe ~€1.75).
# 'mollie'              (DEFAULT — SEPA, Bancontact, iDEAL, cards; low fees)
# 'stripe'              (Stripe Checkout — global cards + wallets, higher fees)
# 'fareharbor'          (delegates to FareHarbor booking URL)
# 'mailto'              (contact-only fallback, no live payments)
# 'stripe-connect'      (DEFER UNTIL TENANT #1 SIGNS — throws on activation)
PAYMENT_VENDOR=mollie

# ---------- Mollie (DEFAULT processor) -------------------------------
# Mollie dashboard → Developers → API keys → Live key (live_...) / Test key (test_...)
MOLLIE_API_KEY=
# Random 32+ char hex; matched constant-time as URL secret on webhook receipts.
MOLLIE_WEBHOOK_SECRET=

# ---------- Stripe (fallback processor — set PAYMENT_VENDOR=stripe to use) -----
# Stripe dashboard → Developers → API keys → Secret key (sk_live_ or sk_test_)
STRIPE_SECRET_KEY=
# Stripe dashboard → Developers → Webhooks → endpoint signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Stripe dashboard → Products → Adopt-a-Paca → Pricing → Price ID (price_...)
STRIPE_ADOPT_PRICE_ID_MONTHLY=
STRIPE_ADOPT_PRICE_ID_YEARLY=

# ---------- Adopt-a-Paca discount codes (Tier 2) ---------------------
# Both must be set for the discount-codes follow-up email to render real codes.
# Either unset → graceful "codes arriving shortly" placeholder.
ADOPT_DISCOUNT_CODE_WEAVING_10=
ADOPT_DISCOUNT_CODE_FARMSHOP_15=

# ---------- Pricing overrides (optional) -----------------------------
# Defaults to constants in lib/config.ts. Set only to change without redeploying.
YOGA_PRICE_EUR=
ADOPT_PRICE_MONTHLY_EUR=
ADOPT_PRICE_YEARLY_EUR=

# ---------- Owner real-time escalation notifications (all optional) -------
# When ANY of these is set, the failure-tracker fires a notification on
# severity transitions to 'at-risk' or 'action-required' (skips 'first').
# Slack: incoming-webhook URL (Slack dashboard → Apps → Incoming Webhooks)
OWNER_SLACK_WEBHOOK_URL=
# Telegram: a bot token + chat ID. Get a bot via BotFather, then talk to it
# and get the chat ID from getUpdates. Both must be set together.
OWNER_TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
# Discord: server → channel settings → Integrations → Webhooks → Copy Webhook URL
OWNER_NOTIFY_DISCORD_URL=
# Generic webhook for custom integrations (Zapier, n8n, Make, etc). Receives
# the EscalationNotification JSON verbatim.
OWNER_GENERIC_WEBHOOK_URL=

# ---------- Resend bounce/complaint webhook (Tier 2 — recommended) -------
# Protects sender reputation. Without this, bounced addresses get retried.
# Resend dashboard → Webhooks → Add Endpoint → https://alpacasibiza.com/api/resend-webhook
# Select events: email.bounced AND email.complained. Copy the signing secret below.
# The route is fail-CLOSED: refuses webhook if this is unset (security-critical).
RESEND_WEBHOOK_SECRET=

# ---------- FareHarbor per-route webhook secrets (optional, Tier 2) ------
# If FareHarbor support configures per-endpoint webhook headers, set these:
# REMINDER_WEBHOOK_SECRET    → x-webhook-secret header on /api/reminder POSTs
# REVIEW_REQUEST_WEBHOOK_SECRET → x-webhook-secret header on /api/review-request POSTs
# If unset, both routes are fail-OPEN (they accept any POST from FareHarbor).
# Generate: openssl rand -hex 32 for each.
REMINDER_WEBHOOK_SECRET=
REVIEW_REQUEST_WEBHOOK_SECRET=

# ---------- Legal flag (flip to 'true' once legal pages have real text) ---
# Set LEGAL_CONTENT_LIVE=true in Vercel env after pasting lawyer-approved copy
# into translations/en.json (legal.privacy.body, legal.terms.body,
# legal.cookies.body, legal.impressum.body) and repeating for other locales.
# Without this, legal pages render a "content pending" placeholder.
LEGAL_CONTENT_LIVE=

# ---------- Cron dead-man's-switch heartbeats (all optional) -------------
# Create free checks at https://healthchecks.io (free tier: 20 checks).
# If Vercel stops firing crons silently, the monitor alerts you.
# Set each to the corresponding https://hc-ping.com/<uuid> URL.
HEARTBEAT_OWNER_MRR_DIGEST_URL=
HEARTBEAT_OWNER_DIGEST_URL=
HEARTBEAT_ADOPT_QUARTERLY_UPDATE_URL=
HEARTBEAT_ADOPT_MILESTONE_EMAILS_URL=

# ---------- Skein sponsorship (seasonal — off by default) ----------------
# SKEIN_CALLOUT_LIVE=true enables the homepage callout during shearing season.
# SKEIN_PRICE_EUR overrides the €200 default (staging tests only — do not set in prod).
SKEIN_CALLOUT_LIVE=
# SKEIN_PRICE_EUR=200

# ---------- Customer / subscription persistence (Tier 2 — optional) -------
# OPTIONAL — when set, payment events persist to Postgres for the admin
# dashboards. Without it, dashboards fall back to live Mollie iteration.
# Get a free Neon/Supabase Postgres → paste connection string here.
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# ==========================================================================
# Referenced in code but previously undocumented — added by the 2026-06-06
# env-drift sweep (audit blind spot #3: env vars added per-cycle never landed
# here). All optional; each feature degrades cleanly when unset.
# ==========================================================================

# ---------- Google Reviews badge + star rating (Tier 2 — optional) --------
# Unset → GoogleReviewsBadge renders nothing. Get from Google Cloud console.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=
# Optional — embeds a Google map instead of the no-key OpenStreetMap fallback.
GOOGLE_MAPS_EMBED_API_KEY=

# ---------- FareHarbor adopt-a-paca item IDs (Tier 2 — optional) ----------
# Only used when PAYMENT_VENDOR=fareharbor. Unset → adopt CTA falls back.
FAREHARBOR_ITEM_ADOPT_MONTHLY=
FAREHARBOR_ITEM_ADOPT_YEARLY=

# ---------- Payment client/config (Tier 2 — optional) ---------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MOLLIE_PROFILE_ID=
# CHECKOUT_MODE — override the checkout flow; leave unset for the default.
CHECKOUT_MODE=

# ---------- Owner notifications (Tier 2 — optional) -----------------------
# Falls back to CONTACT_EMAIL when unset.
OWNER_EMAIL=

# ---------- Adopt campaign banner (Tier 2 — optional) ---------------------
# When set, the adopt page shows a time-boxed campaign headline/subline.
ADOPT_CAMPAIGN_HEADLINE=
ADOPT_CAMPAIGN_SUBLINE=
ADOPT_CAMPAIGN_END_DATE=

# ---------- Vercel Blob (Tier 2 — optional, infra) ------------------------
# Auto-provided when a Vercel Blob store is attached; only set manually if
# self-hosting blob storage.
BLOB_READ_WRITE_TOKEN=
